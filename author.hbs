{{!< default}}

{{#author}}
{{#contentFor "body_class"}} author-template author-{{slug}}{{/contentFor}}

<div class="author-page">
    <div class="container">
        {{!-- Author Header --}}
        <header class="author-header">
            {{#if profile_image}}
                <img src="{{img_url profile_image size="xl"}}" alt="{{name}}" class="author-image">
            {{/if}}
            <div class="author-info">
                <h1 class="author-name">{{name}}</h1>
                {{#if bio}}
                    <p class="author-bio">{{bio}}</p>
                {{/if}}
                <div class="author-meta">
                    {{#if location}}
                        <span class="author-location">📍 {{location}}</span>
                    {{/if}}
                    {{#if website}}
                        <a href="{{website}}" class="author-website" target="_blank" rel="noopener">🌐 Website</a>
                    {{/if}}
                </div>
                <div class="author-stats">
                    <span class="post-count">{{plural ../pagination.total empty='Belum ada artikel' singular='% artikel' plural='% artikel'}}</span>
                </div>
            </div>
        </header>

        {{!-- Author Posts --}}
        {{#if posts}}
            <section class="author-posts">
                <h2 class="section-title">Artikel oleh {{name}}</h2>
                <div class="news-grid">
                    {{#foreach posts}}
                        <article class="news-article">
                            {{#if feature_image}}
                                <div class="article-image">
                                    <a href="{{url}}">
                                        <img src="{{img_url feature_image size="s"}}" alt="{{title}}" loading="lazy">
                                    </a>
                                </div>
                            {{/if}}
                            <div class="article-content">
                                {{#if primary_tag}}
                                    <span class="article-tag">{{primary_tag.name}}</span>
                                {{/if}}
                                <h3 class="article-title">
                                    <a href="{{url}}">{{title}}</a>
                                </h3>
                                {{#if excerpt}}
                                    <p class="article-excerpt">{{excerpt}}</p>
                                {{/if}}
                                <div class="article-meta">
                                    <time datetime="{{date format="YYYY-MM-DD"}}">
                                        {{date format="DD MMMM YYYY"}}
                                    </time>
                                    <span class="reading-time">{{reading_time minute="menit" minutes="menit"}}</span>
                                </div>
                            </div>
                        </article>
                    {{/foreach}}
                </div>

                {{!-- Pagination --}}
                {{pagination}}
            </section>
        {{else}}
            <div class="no-posts">
                <h2>Belum ada artikel yang ditulis</h2>
                <p>{{name}} belum menerbitkan artikel apapun.</p>
            </div>
        {{/if}}
    </div>
</div>

{{/author}}

