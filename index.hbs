{{!< default}}

{{#contentFor "body_class"}}home-template{{/contentFor}}

<div class="homepage">
  <div class="container">
    {{#if posts}}

      {{!-- Hero Section: Featured Posts --}}
      <section class="hero-section">
        {{#get "posts" limit="10" filter="featured:true"}}
          {{#foreach posts}}
            <article class="hero-article">
              {{#if feature_image}}
                <div class="hero-image">
                  <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" loading="eager">
                </div>
              {{/if}}
              <div class="hero-content">
                <h1 class="hero-title"><a href="{{url}}">{{title}}</a></h1>
                {{#if excerpt}}<p class="hero-excerpt">{{excerpt}}</p>{{/if}}
                <div class="hero-meta">
                  <time datetime="{{date format="YYYY-MM-DD"}}">{{date timeago="true"}}</time>
                  {{#primary_author}}<span class="author">oleh {{name}}</span>{{/primary_author}}
                </div>
              </div>
            </article>
          {{/foreach}}
        {{/get}}
      </section>

      {{!-- Breaking News --}}
      {{#get "posts" limit="3" filter="tag:breaking"}}
        {{#if posts}}
          <section class="breaking-news">
            <h2 class="section-title">Berita Utama</h2>
            <div class="breaking-grid">
              {{#foreach posts}}
                <article class="breaking-article">
                  {{#if feature_image}}
                    <div class="article-image">
                      <a href="{{url}}">
                        <img src="{{img_url feature_image size="s"}}" alt="{{title}}" loading="lazy">
                      </a>
                    </div>
                  {{/if}}
                  <div class="article-content">
                    <h3 class="article-title"><a href="{{url}}">{{title}}</a></h3>
                    {{#if excerpt}}<p class="article-excerpt">{{excerpt}}</p>{{/if}}
                    <div class="article-meta">
                      <time datetime="{{date format="YYYY-MM-DD"}}">{{date timeago="true"}}</time>
                    </div>
                  </div>
                </article>
              {{/foreach}}
            </div>
          </section>
        {{/if}}
      {{/get}}

      {{!-- Latest News --}}
      <section class="latest-news">
        <h2 class="section-title">Berita Terbaru</h2>
        <div class="news-grid">
          {{#foreach posts}}
            <article class="news-article">
              {{#if feature_image}}
                <div class="article-image">
                  <a href="{{url}}">
                    <img src="{{img_url feature_image size="s"}}" alt="{{title}}" loading="lazy">
                  </a>
                </div>
              {{/if}}
              <div class="article-content">
                {{#if primary_tag}}<span class="article-tag">{{primary_tag.name}}</span>{{/if}}
                <h3 class="article-title"><a href="{{url}}">{{title}}</a></h3>
                {{#if excerpt}}<p class="article-excerpt">{{excerpt}}</p>{{/if}}
                <div class="article-meta">
                  <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMMM YYYY"}}</time>
                  {{#primary_author}}<span class="author">{{name}}</span>{{/primary_author}}
                </div>
              </div>
            </article>
          {{/foreach}}
        </div>
        {{pagination}}
      </section>

    {{else}}
      <div class="no-posts">
        <h2>Belum ada artikel yang dipublikasikan</h2>
        <p>Silakan periksa kembali nanti untuk konten terbaru.</p>
      </div>
    {{/if}}
  </div>

  {{!-- Sidebar --}}
  <aside class="sidebar">
    <div class="container">

      {{!-- Popular Posts --}}
      <div class="sidebar-widget">
        <h3 class="widget-title">Artikel Terpopuler</h3>
        {{#get "posts" limit="5" order="published_at desc"}}
          <div class="popular-posts">
            {{#foreach posts}}
              <article class="popular-article">
                <div class="popular-number">{{@number}}</div>
                <div class="popular-content">
                  <h4><a href="{{url}}">{{title}}</a></h4>
                  <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMMM YYYY"}}</time>
                </div>
              </article>
            {{/foreach}}
          </div>
        {{/get}}
      </div>

      {{!-- Categories --}}
      <div class="sidebar-widget">
        <h3 class="widget-title">Kategori</h3>
        {{#get "tags" limit="20" filter="visibility:public"}}
          <div class="categories">
            {{#foreach tags}}
              <a href="{{url}}" class="category-link">{{name}}</a>
            {{/foreach}}
          </div>
        {{/get}}
      </div>

      {{!-- Newsletter Signup --}}
      <div class="sidebar-widget newsletter-widget">
        <h3 class="widget-title">Berlangganan Newsletter</h3>
        <p>Dapatkan berita terbaru langsung di inbox Anda.</p>
        <form class="newsletter-form" action="#" method="post" aria-label="Formulir Berlangganan">
          <input type="email" name="email" placeholder="Email Anda" required>
          <button type="submit">Berlangganan</button>
        </form>
      </div>

    </div>
  </aside>
</div>