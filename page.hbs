{{!< default}}

{{#post}}
{{#contentFor "body_class"}} page-template page-{{slug}}{{/contentFor}}

{{#if @custom.show_publication_cover}}
    {{#if @site.cover_image}}
        <section class="cover-image">
            <img src="{{@site.cover_image}}" alt="{{@site.title}}">
        </section>
    {{/if}}
{{/if}}

<article class="page">
    <div class="container">

        {{#if @page.show_title_and_feature_image}}
            <header class="page-header">
                <h1 class="page-title">{{title}}</h1>

                {{#if excerpt}}
                    <p class="page-excerpt">{{excerpt}}</p>
                {{/if}}

                <div class="page-meta">
                    <time datetime="{{date format="YYYY-MM-DD"}}">
                        Terakhir diperbarui: {{date format="DD MMMM YYYY"}}
                    </time>
                </div>
            </header>

            {{#if feature_image}}
                <figure class="page-image">
                    <img src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="eager">
                    {{#if feature_image_caption}}
                        <figcaption>{{feature_image_caption}}</figcaption>
                    {{/if}}
                </figure>
            {{/if}}
        {{/if}}

        <div class="page-content">
            {{content}}
        </div>

    </div>
</article>
{{/post}}