{{! Footer }}
<footer class="site-footer">
  <div class="container">
    <div class="footer-content">

      {{!-- Kolom kiri: logo, deskripsi, sosial --}}
      <div class="footer-info">
        {{#if @site.logo}}
          <img src="{{@site.logo}}" alt="{{@site.title}}" class="footer-logo" />
        {{else}}
          <h3 class="footer-title">{{@site.title}}</h3>
        {{/if}}

        {{#if @site.description}}
          <p class="footer-description">{{@site.description}}</p>
        {{/if}}

        <div class="social-links">
          {{#if @site.facebook}}
            <a href="{{social_url type="facebook"}}" target="_blank" rel="noopener" aria-label="Facebook">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                <path d="M22.675 0h-21.35C.597 0 0 .597 0 
                1.325v21.351C0 23.403.597 24 1.325 
                24h11.495v-9.294H9.691V11.01h3.129V8.414c0-3.1 
                1.893-4.788 4.659-4.788 1.325 
                0 2.464.099 2.795.143v3.24h-1.918c-1.504 
                0-1.796.715-1.796 1.763v2.312h3.587l-.467 
                3.696h-3.12V24h6.116C23.403 24 24 
                23.403 24 22.676V1.325C24 .597 23.403 
                0 22.675 0z"/>
              </svg>
            </a>
          {{/if}}

          {{#if @site.twitter}}
            <a href="{{social_url type="twitter"}}" target="_blank" rel="noopener" aria-label="Twitter">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                <path d="M23.954 4.569c-.885.389-1.83.654-2.825.775 
                1.014-.611 1.794-1.574 2.163-2.723-.951.555-2.005.959-3.127 
                1.184-.897-.959-2.178-1.555-3.594-1.555-2.717 
                0-4.924 2.207-4.924 4.924 0 .39.045.765.127 
                1.124-4.09-.205-7.719-2.165-10.148-5.144-.424.729-.667 
                1.577-.667 2.475 0 1.708.87 3.216 2.188 
                4.099-.807-.026-1.566-.248-2.229-.616v.061c0 
                2.385 1.693 4.374 3.946 
                4.827-.413.111-.849.171-1.296.171-.317 
                0-.626-.03-.928-.086.627 1.956 2.444 
                3.377 4.6 3.418-1.68 1.319-3.809 
                2.105-6.102 2.105-.396 0-.788-.023-1.175-.067 
                2.179 1.397 4.768 2.212 7.557 
                2.212 9.054 0 14-7.496 14-13.986 
                0-.21 0-.423-.015-.634.962-.689 
                1.8-1.56 2.46-2.548l-.047-.02z"/>
              </svg>
            </a>
          {{/if}}
        </div>
      </div>

      {{!-- Kolom kanan: secondary navigation --}}
      <div class="footer-nav">
        <nav class="site-navigation secondary-nav">
          <ul class="nav-list">
            {{#foreach @site.secondary_navigation}}
              <li class="nav-item">
                <a href="{{this.url}}" class="nav-link {{#if current}}nav-current{{/if}}">
                  {{label}}
                </a>
              </li>
            {{/foreach}}
          </ul>
        </nav>
      </div>

    </div>

    {{!-- Bagian bawah --}}
    <div class="footer-bottom">
      <p>&copy; {{date format="YYYY"}} {{@site.title}}. All rights reserved.</p>
      <p>
        Powered by
        <a href="https://ghost.org" target="_blank" rel="noopener">Ghost</a>
      </p>
    </div>
  </div>
</footer>
