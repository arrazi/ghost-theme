<div class="share-buttons-bar" role="group" aria-label="Bagikan artikel">
  <!-- WhatsApp -->
  <a
    href="https://wa.me/?text={{encode title}}%20{{url absolute="true"}}"
    class="share-btn whatsapp"
    target="_blank"
    rel="noopener"
    aria-label="Bagikan ke WhatsApp"
  >
    <svg viewBox="0 0 32 32"><path
        d="M16 .7C7.6.7.7 7.6.7 16c0 2.7.7 5.4 2.1 7.7L0 32l8.6-2.7c2.3 1.3 4.9 2 7.6 2 8.4 0 15.3-6.9 15.3-15.3S24.4.7 16 .7zm0 27.9c-2.4 0-4.7-.6-6.8-1.9l-.5-.3-5.1 1.6 1.6-5-.3-.5c-1.3-2.1-2-4.4-2-6.9C3 9 9 3 16 3s13 6 13 13-6 12.6-13 12.6zm7.1-9.3c-.4-.2-2.3-1.1-2.6-1.2-.3-.1-.5-.2-.7.2s-.8 1.2-1 1.5c-.2.3-.4.3-.8.1s-1.5-.6-2.8-1.8c-1-1-1.6-2.2-1.8-2.6-.2-.4 0-.6.1-.8s.3-.5.5-.7c.2-.2.3-.4.4-.6.1-.2 0-.5 0-.7s-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1 2.9 1.2 3.1c.2.3 2 3.1 5 4.3.7.3 1.2.5 1.6.6.7.2 1.4.2 1.9.1.6-.1 2.3-1 2.6-1.9.3-.9.3-1.7.2-1.9-.1-.2-.3-.3-.7-.5z"
      /></svg>
  </a>

  <!-- Facebook -->
  <a
    href="https://www.facebook.com/sharer/sharer.php?u={{url absolute="true"}}"
    class="share-btn facebook"
    target="_blank"
    rel="noopener"
    aria-label="Bagikan ke Facebook"
  >
    <svg viewBox="0 0 24 24"><path
        d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 5 3.66 9.13 8.44 9.88v-6.99H7.9v-2.89h2.54V9.41c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.62.77-1.62 1.56v1.87h2.77l-.44 2.89h-2.33v6.99C18.34 21.13 22 17 22 12"
      /></svg>
  </a>

  <!-- Twitter -->
  <a
    href="https://twitter.com/intent/tweet?text={{encode title}}&url={{url
      absolute="true"
    }}"
    class="share-btn twitter"
    target="_blank"
    rel="noopener"
    aria-label="Bagikan ke Twitter"
  >
    <svg viewBox="0 0 24 24"><path
        d="M22.46 6c-.77.35-1.6.58-2.46.69a4.26 4.26 0 001.88-2.35 8.48 8.48 0 01-2.7 1.03 4.22 4.22 0 00-7.2 3.85A12 12 0 013 4.8a4.22 4.22 0 001.3 5.63 4.22 4.22 0 01-1.91-.53v.05a4.22 4.22 0 003.39 4.13 4.28 4.28 0 01-1.9.07 4.22 4.22 0 003.94 2.93A8.47 8.47 0 012 19.54 12 12 0 008.29 21c7.55 0 11.68-6.26 11.68-11.68 0-.18 0-.35-.01-.53A8.36 8.36 0 0022.46 6z"
      /></svg>
  </a>

  <!-- LinkedIn -->
  <a
    href="https://www.linkedin.com/sharing/share-offsite/?url={{url
      absolute="true"
    }}"
    class="share-btn linkedin"
    target="_blank"
    rel="noopener"
    aria-label="Bagikan ke LinkedIn"
  >
    <svg viewBox="0 0 24 24"><path
        d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.77 0 5-2.24 5-5v-14c0-2.76-2.23-5-5-5zm-11 19h-3v-10h3v10zm-1.5-11.3c-.97 0-1.75-.79-1.75-1.75S5.53 4.2 6.5 4.2c.97 0 1.75.79 1.75 1.75s-.78 1.75-1.75 1.75zm13.5 11.3h-3v-5.6c0-1.34-.03-3.06-1.87-3.06-1.88 0-2.17 1.47-2.17 2.97v5.7h-3v-10h2.89v1.36h.04c.4-.76 1.39-1.56 2.86-1.56 3.06 0 3.63 2.01 3.63 4.62v5.58z"
      /></svg>
  </a>
  <!-- Telegram -->
  <a
    href="https://t.me/share/url?url={{url absolute="true"}}&text={{encode
      title
    }}"
    class="share-btn telegram"
    target="_blank"
    rel="noopener"
    aria-label="Bagikan ke Telegram"
  >
    <svg viewBox="0 0 24 24"><path
        d="M9.03 18.12l-.4 4.72c.57 0 .82-.24 1.12-.52l2.68-2.53 5.55 4.05c1.02.56 1.74.27 2-.95l3.63-17.05c.32-1.48-.53-2.06-1.53-1.7L1.7 9.48c-1.45.58-1.43 1.39-.26 1.76l4.64 1.44 10.8-6.8c.51-.33 1.01-.15.61.21"
      /></svg>
  </a>
</div>